{
  "info": {
    "_postman_id": "bdf-gamezone-arcade-collection-2026",
    "name": "GameZone Arcade - Console Stations API",
    "description": "Backend Development Fundamentals (BDF) - Modules 1 to 3\nTheme 16 of 30 · Console stations (ST-CSE2A-G01)\nCard 286 of 375 · Sai Siva Teja\nIncludes automated tests for all twist tests and core CRUD/join endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health & Welcome",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Root server status and API index"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1. Twist Tests (Must Pass)",
      "item": [
        {
          "name": "Test 1: End before start -> 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gamer_id\": 1,\n  \"console_id\": 2,\n  \"start_date\": \"2026-11-15\",\n  \"end_date\": \"2026-11-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "Twist Test 1: Booking end date before start date must return HTTP 400"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 1 Passed: Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Test 1 Passed: Error indicates end date cannot be before start date', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include('cannot be before');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 2: available?date=YYYY-MM-DD (2026-11-11) -> Console 4 MISSING (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles/available?date=2026-11-11",
              "host": ["{{baseUrl}}"],
              "path": ["consoles", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-11-11",
                  "description": "YYYY-MM-DD format as required by Client Brief Card: Booking 10-12 Nov, so Console 4 must be missing on 11 Nov"
                }
              ]
            },
            "description": "Twist Test 2: Booking for Console 4 is 10 to 12 Nov. Available query on 11 Nov must return 200 with Console 4 MISSING."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 2 Passed: Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Test 2 Passed: Console 4 is MISSING from available list', function () {",
                  "    var json = pm.response.json();",
                  "    var console4 = json.consoles.find(c => c.id === 4);",
                  "    pm.expect(console4).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 2 (Alt): available?date=11 Nov -> Console 4 MISSING",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles/available?date=11%20Nov",
              "host": ["{{baseUrl}}"],
              "path": ["consoles", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "11 Nov",
                  "description": "Textual format '11 Nov'"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 2 (Alt) Passed: Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Test 2 (Alt) Passed: Console 4 is MISSING', function () {",
                  "    var json = pm.response.json();",
                  "    var console4 = json.consoles.find(c => c.id === 4);",
                  "    pm.expect(console4).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 3: available?date=YYYY-MM-DD (2026-11-13) -> Console 4 LISTED (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles/available?date=2026-11-13",
              "host": ["{{baseUrl}}"],
              "path": ["consoles", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-11-13",
                  "description": "YYYY-MM-DD format: Booking ended on 12 Nov, so Console 4 must be available on 13 Nov"
                }
              ]
            },
            "description": "Twist Test 3: Booking for Console 4 ended on 12 Nov. Available query on 13 Nov must return 200 with Console 4 LISTED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 3 Passed: Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Test 3 Passed: Console 4 is LISTED as available', function () {",
                  "    var json = pm.response.json();",
                  "    var console4 = json.consoles.find(c => c.id === 4);",
                  "    pm.expect(console4).to.not.be.undefined;",
                  "    pm.expect(console4.id).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 3 (Alt): available?date=13 Nov -> Console 4 LISTED",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles/available?date=13%20Nov",
              "host": ["{{baseUrl}}"],
              "path": ["consoles", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "13 Nov",
                  "description": "Textual format '13 Nov'"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 3 (Alt) Passed: Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Test 3 (Alt) Passed: Console 4 is LISTED', function () {",
                  "    var json = pm.response.json();",
                  "    var console4 = json.consoles.find(c => c.id === 4);",
                  "    pm.expect(console4).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Consoles Endpoints (CRUD + Search)",
      "item": [
        {
          "name": "Get All Consoles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles",
              "host": ["{{baseUrl}}"],
              "path": ["consoles"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns console list array', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search Consoles by Platform (?platform=PlayStation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles?platform=PlayStation",
              "host": ["{{baseUrl}}"],
              "path": ["consoles"],
              "query": [
                {
                  "key": "platform",
                  "value": "PlayStation"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('All returned consoles match PlayStation', function () {",
                  "    var json = pm.response.json();",
                  "    json.forEach(c => pm.expect(c.platform.toLowerCase()).to.include('playstation'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get One Console (Console 4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/consoles/4",
              "host": ["{{baseUrl}}"],
              "path": ["consoles", "4"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Console ID is 4', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Console (POST /consoles)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Station 7 - Nintendo Switch OLED\",\n  \"platform\": \"Nintendo Switch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/consoles",
              "host": ["{{baseUrl}}"],
              "path": ["consoles"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Returns created console with ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

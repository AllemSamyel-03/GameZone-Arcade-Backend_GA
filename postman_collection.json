    {
      "name": "4. Bookings & Join Endpoint",
      "item": [
        {
          "name": "Join Endpoint: Bookings with Gamer and Console Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "One join endpoint: bookings with the gamer name and the console name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains gamer_name and console_name fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.length).to.be.above(0);",
                  "    pm.expect(json[0]).to.have.property('gamer_name');",
                  "    pm.expect(json[0]).to.have.property('console_name');",
                  "    pm.expect(json[0]).to.have.property('start_date');",
                  "    pm.expect(json[0]).to.have.property('end_date');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
